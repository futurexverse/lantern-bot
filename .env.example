# ── LANTERN Telegram bot — PER-USER WALLET MODE ────────────────────────
# Copy this file to `.env` and fill in the values.
# Each user trades from their own Phantom wallet — the server holds NO keys.

# 1) Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# 2) URL of your Vercel-hosted trade page (lantern-frontend/trade.html)
#    After `git push` to Vercel, your URL looks like:
#    https://your-app.vercel.app/trade.html
WEBAPP_URL=

# 3) Public URL of this bot process (Railway provides one after deploy).
#    Used by the trade page to POST successful trades back to /trades.
#    Optional: leave empty → swaps work, /trades stays empty.
BOT_API_URL=

# 4) Shared secret for /api/record-trade. Generate with:
#    node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
#    If set, append ?key=THIS_VALUE to your WEBAPP_URL.
RECORD_KEY=

# 5) Solana RPC. Public defaults work but rate-limit — get a free Helius key.
RPC_MAINNET=https://api.mainnet-beta.solana.com
RPC_DEVNET=https://api.devnet.solana.com

# 6) Alert chat IDs (optional — users self-subscribe via /alerts on)
ALERT_CHAT_IDS=
ALERT_INTERVAL_SECONDS=120

# 7) Trading defaults
SLIPPAGE_BPS=50

# 8) Data persistence (Railway: change to /data/store.json after mounting volume)
STORE_PATH=./store.json

# 9) HTTP port (Railway provides PORT automatically)
PORT=3000
